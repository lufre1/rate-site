# PostgreSQL
DB_USER=user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mensa_db

# Backend connection (must match DB_USER, POSTGRES_PASSWORD, POSTGRES_DB)
DATABASE_URL=postgresql://user:change-me-strong-password@db:5432/mensa_db

# Frontend API URL used at build time, inlined into the bundle by CRA.
# Behind the reverse proxy this must be EMPTY: the browser is same-origin, so the
# code's `${API}/api/v1/...` has to resolve to `/api/v1/...`, which the proxy
# routes straight to the backend. Setting `/api` instead produces
# `/api/api/v1/...`, which only worked because the frontend container's nginx
# stripped the extra prefix on a second hop.
# For a separate API host: "https://mensa-api.example.com" (no trailing slash).
# NOTE: shared.js uses `??`, so an empty value is honoured. Do not change it back
# to `||` -- that turns "" into the localhost fallback and breaks every request.
REACT_APP_API_URL=
